pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        choice(
            name: 'TEST_SET',
            choices: ['smoke', 'api', 'regression', 'ui'], // Добавили ui
            description: 'Marker pytest'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
            }
        }

        stage('Prepare') {
            steps {
                script {
                    def safeJobName = env.JOB_BASE_NAME
                        .toLowerCase()
                        .replaceAll('[^a-z0-9_.-]+', '-')
                        .take(32)

                    env.COMPOSE_PROJECT_NAME =
                        "aqa-${safeJobName}-${env.BUILD_NUMBER}"
                    
                    echo "Сгенерирован COMPOSE_PROJECT_NAME: ${env.COMPOSE_PROJECT_NAME}"
                }

                dir('aqa-docker') {
                    sh '''
                        rm -rf allure-results test-results
                        mkdir -p allure-results test-results
                    '''
                }
            }
        }

        stage('Validate') {
            steps {
                dir('aqa-docker') {
                    sh 'docker compose config --quiet'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('aqa-docker') {
                    sh '''
                        PYTEST_MARKER="$TEST_SET" \
                        docker compose -p "$COMPOSE_PROJECT_NAME" up \
                          --build \
                          --abort-on-container-exit \
                          --exit-code-from tests
                    '''
                }
            }
        }

        stage('Authenticated API tests') {
            environment {
                API_TOKEN = credentials('aqa-api-token')
            }
            steps {
                dir('aqa-docker') {
                    sh '''
                        API_TOKEN="$API_TOKEN" \
                        PYTEST_MARKER=auth \
                        docker compose -p "$COMPOSE_PROJECT_NAME" up \
                          --build \
                          --abort-on-container-exit \
                          --exit-code-from tests
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                // Вытаскиваем результаты и скриншоты из контейнера
                dir('aqa-docker') {
                    sh """
                        CONTAINER_ID=\$(docker ps -a -q -f name=\${COMPOSE_PROJECT_NAME}-tests-1)
                        if [ -n "\$CONTAINER_ID" ]; then
                            docker cp \$CONTAINER_ID:/app/allure-results/. ./allure-results || true
                            docker cp \$CONTAINER_ID:/app/test-results/. ./test-results || true
                        fi
                    """
                }

                // Проверяем Allure
                def allureResultsExist = 0
                dir('aqa-docker') {
                    allureResultsExist = sh(
                        script: '''
                            test -d allure-results &&
                            find allure-results -type f -print -quit | grep -q .
                        ''',
                        returnStatus: true
                    )
                }

                if (allureResultsExist == 0) {
                    dir('aqa-docker') {
                        archiveArtifacts artifacts: 'allure-results/**'
                        archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true // Сохраняем скриншоты
                        allure results: [[path: 'allure-results']]
                    }
                } else {
                    echo 'Allure results не созданы'
                    if (currentBuild.currentResult == 'SUCCESS') {
                        currentBuild.result = 'FAILURE'
                    }
                }
            }
        }

        cleanup {
            script {
                if (env.COMPOSE_PROJECT_NAME?.trim()) {
                    dir('aqa-docker') {
                        sh '''
                            docker compose -p "$COMPOSE_PROJECT_NAME" down \
                              --remove-orphans \
                              --rmi local || true
                        '''
                    }
                }
            }
        }
    }
}
